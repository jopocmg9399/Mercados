{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "An individual store in the Mall.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "province": { "type": "string" },
            "municipality": { "type": "string" },
            "locality": { "type": "string" }
          }
        },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "slug", "ownerId", "location", "active", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "A product available for sale in a specific store.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "category": { "type": "string" },
        "stock": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["storeId", "name", "price", "currency", "category", "stock", "active", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order for a specific store.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "items": { "type": "array" },
        "totalCUP": { "type": "number" },
        "totalMLC": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["storeId", "customerName", "customerPhone", "customerAddress", "items", "totalCUP", "totalMLC", "status", "createdAt"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global settings for the PaTí platform.",
      "type": "object",
      "properties": {
        "commissionRate": { "type": "number" },
        "platformLogo": { "type": "string" },
        "currentVersion": { "type": "string" },
        "releases": { "type": "array" }
      }
    },
    "DailyClose": {
      "title": "DailyClose",
      "description": "Daily operational closing summary for a store.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string" },
        "closedAt": { "type": "number" },
        "closedBy": { "type": "string" },
        "totalSalesCUP": { "type": "number" },
        "totalSalesMLC": { "type": "number" },
        "ordersCount": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["storeId", "closedAt", "closedBy", "totalSalesCUP", "totalSalesMLC", "ordersCount", "notes"]
    },
    "CommissionPayment": {
      "title": "CommissionPayment",
      "description": "Payment or reconciliation event for commission fees generated by a store.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string" },
        "amountCUP": { "type": "number" },
        "amountMLC": { "type": "number" },
        "recordedAt": { "type": "number" },
        "recordedBy": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["storeId", "amountCUP", "amountMLC", "recordedAt", "recordedBy", "notes"]
    }
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "Collection of stores."
    },
    "/commission_payments/{paymentId}": {
      "schema": "CommissionPayment",
      "description": "Historic commission collection logs and store reconciliations."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of products across all stores."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of orders across all stores."
    },
    "/daily_closes/{closeId}": {
      "schema": "DailyClose",
      "description": "Collection of daily operations closes across all stores."
    },
    "/platform_settings/{docId}": {
      "schema": "PlatformSettings",
      "description": "Global platform configuration."
    }
  }
}
